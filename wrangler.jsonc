{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygov-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "mygov-mcp.faizalmzain.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
